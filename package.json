{
  "name": "irflow-timeline",
  "version": "1.0.5",
  "description": "IRFlow Timeline — High-performance DFIR timeline viewer for Windows",
  "main": "electron/main.js",
  "author": "DFIR Community",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",

    "dist:win": "npm run build:renderer && electron-builder --win",
    "dist:win:nsis": "npm run build:renderer && electron-builder --win nsis",
    "dist:win:portable": "npm run build:renderer && electron-builder --win portable",

    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "patch-package",

    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "build": {
    "appId": "com.irflow.timeline",
    "productName": "IRFlow Timeline",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IRFlow Timeline"
    },
    "fileAssociations": [
      {
        "ext": "tle",
        "name": "IRFlow Timeline Session",
        "description": "IRFlow Timeline Session File",
        "role": "Editor"
      },
      {
        "ext": "csv",
        "name": "CSV File",
        "role": "Viewer"
      },
      {
        "ext": "tsv",
        "name": "TSV File",
        "role": "Viewer"
      },
      {
        "ext": "evtx",
        "name": "Windows Event Log",
        "role": "Viewer"
      },
      {
        "ext": "xlsx",
        "name": "Excel Workbook",
        "role": "Viewer"
      },
      {
        "ext": "sqlite",
        "name": "SQLite Database",
        "role": "Viewer"
      },
      {
        "ext": "db",
        "name": "SQLite Database",
        "role": "Viewer"
      }
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "patch-package": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7",
    "vitepress": "^1.6.4",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@ts-evtx/core": "^1.1.1",
    "@ts-evtx/messages": "^1.1.1",
    "better-sqlite3": "^11.7.0",
    "csv-parser": "^3.0.0",
    "electron-updater": "^6.6.7",
    "unzipper": "^0.10.14",
    "exceljs": "^4.4.0",
    "xlsx": "^0.18.5"
  }
}
